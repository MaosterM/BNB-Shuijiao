# BSC TESTNET ONLY (chainId 97). Scripts refuse to run against any other chain.
RPC_HTTP=https://bsc-testnet-rpc.publicnode.com
RPC_WS=wss://bsc-testnet-rpc.publicnode.com

# Test wallets: generate with `npm run wallets` (writes .env, prints addresses only)
DEPLOYER_PK=
DEV_PK=
GUARDED_USER_PK=
UNGUARDED_USER_PK=
AGENT_PK=

# Optional: only used for the non-urgent pre-flight brief and post-ejection explanation
LLM_API_KEY=

# Emergency sale slippage tolerance (1500 = 15%)
SLIPPAGE_BPS=1500

# --- Optional knobs (defaults shown) ---
# GUARD_MODE=vault          # vault = GuardedVault contract; altana = Altana session key on the user's own wallet
# LIQ_BNB=0.05              # tBNB put in the RUGME/WBNB pool on each reset
# RUG_DELAY_MS=8000         # pause between DEV's first 5% sale and the full dump
# POLL_MS=1000              # HTTP poll interval (WebSocket new heads also trigger fetches)
# EXPLAIN_DELAY_MS=60000    # wait before writing the post-ejection explanation (demo uses 15000)
# SAFE_LIST=0x...,0x...     # extra staking/vesting/locker addresses that team moves may go to
# T1_TEAM_DEX_SELL_BPS=100  T2_TEAM_BIG_MOVE_BPS=2000  T3_LIQUIDITY_PULL_BPS=1000
# LLM_MODEL=claude-haiku-5-5
# STUDIO_LLM_URL= STUDIO_LLM_KEY= STUDIO_LLM_MODEL=   # OpenAI-compatible endpoint (e.g. Agent Studio / Pieverse)
